{
  "name": "example-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/example-react/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/{options.outDir}", "{workspaceRoot}/dist/apps/example-react"],
      "defaultConfiguration": "production",
      "options": {
        "config": "./vite.config.ts",
        "outDir": "../../dist/apps/example-react"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "options": {
        "configFile": "apps/example-react/vite.config.ts"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/apps/example-react"],
      "options": {
        "config": "./vite.config.ts",
        "coverage.reportsDirectory": "../../coverage/apps/example-react"
      }
    }
  }
}
