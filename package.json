{
  "name": "@ntcore-ts/monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "release": "npm run release:client && npm run release:react",
    "release:client": "cd packages/client && npx -p semantic-release@25 -p semantic-release-monorepo@8 -p @semantic-release/changelog -p @semantic-release/exec -p @semantic-release/git -p @semantic-release/github -p @semantic-release/npm -- semantic-release -e semantic-release-monorepo -c ../../release.config.client.mts",
    "release:react": "cd packages/react && npx -p semantic-release@25 -p semantic-release-monorepo@8 -p @semantic-release/changelog -p @semantic-release/exec -p @semantic-release/git -p @semantic-release/github -p @semantic-release/npm -- semantic-release -e semantic-release-monorepo -c ../../release.config.react.mts",
    "test": "npx nx run-many --target=test --projects=client,react",
    "bench": "nx run client:bench",
    "e2e:local": "nx run example-client:e2e:local"
  },
  "private": true,
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@swc/core@1.15.43": true,
    "core-js@3.49.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "nx@23.0.2": true,
    "unrs-resolver@1.11.1": true
  },
