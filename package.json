{
  "name": "@ntcore-ts/monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "release": "npm run release:client && npm run release:react",
    "release:client": "cd packages/client && npx -p semantic-release@25 -p semantic-release-monorepo@8 -p @semantic-release/changelog -p @semantic-release/exec -p @semantic-release/git -p @semantic-release/github -p @semantic-release/npm -- semantic-release -e semantic-release-monorepo -c ../../release.config.client.mts",
    "release:react": "cd packages/react && npx -p semantic-release@25 -p semantic-release-monorepo@8 -p @semantic-release/changelog -p @semantic-release/exec -p @semantic-release/git -p @semantic-release/github -p @semantic-release/npm -- semantic-release -e semantic-release-monorepo -c ../../release.config.react.mts",
    "test": "npx nx run-many --target=test --projects=client,react",
    "bench": "nx run client:bench",
    "e2e:local": "nx run example-client:e2e:local"
  },
  "private": true,
  "allowScripts": {
    "@swc/core@1.16.0": true,
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "nx@23.1.1": true
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@msgpack/msgpack": "^3.1.3",
    "@nx/devkit": "23.1.1",
    "@nx/esbuild": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/rollup": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.1",
    "@swc/helpers": "0.5.23",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "isomorphic-ws": "^5.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "nx": "23.1.1",
    "prettier": "^3.9.6",
    "protobufjs": "^8.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.4",
    "sass": "^1.102.0",
    "ts-proto": "^2.12.0",
    "tslib": "^2.8.1",
    "tslog": "^4.11.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "4.1.11",
    "vitest-websocket-mock": "^0.7.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  }
