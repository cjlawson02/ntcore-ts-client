{
  "name": "@ntcore/monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "release": "npm run release:client && npm run release:react",
    "release:client": "cd packages/client && npx -p semantic-release@25 -p semantic-release-monorepo@8 -p @semantic-release/changelog -p @semantic-release/exec -p @semantic-release/git -p @semantic-release/github -p @semantic-release/npm -- semantic-release -e semantic-release-monorepo -c ../../release.config.client.mts",
    "release:react": "cd packages/react && npx -p semantic-release@25 -p semantic-release-monorepo@8 -p @semantic-release/changelog -p @semantic-release/exec -p @semantic-release/git -p @semantic-release/github -p @semantic-release/npm -- semantic-release -e semantic-release-monorepo -c ../../release.config.react.mts",
    "test": "npx nx run-many --target=test --projects=client,react",
    "bench": "nx run client:bench",
    "e2e:local": "nx run example-client:e2e:local"
  },
  "private": true,
  "lint-staged": {
    "*": [
      "npx nx format:write --uncommitted",
      "npx nx affected --target=lint-fix --uncommitted",
      "npx nx affected --target=test --uncommitted",
      "npx nx affected --target=build --uncommitted"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@msgpack/msgpack": "^3.1.2",
    "isomorphic-ws": "^5.0.0",
    "protobufjs": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tslib": "^2.8.1",
    "tslog": "^4.10.2",
    "ws": "^8.18.3",
    "zod": "^4.2.1",
    "@babel/preset-react": "^7.14.5",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@nx/devkit": "22.6.1",
    "@nx/esbuild": "22.6.1",
    "@nx/eslint": "22.6.1",
    "@nx/eslint-plugin": "22.6.1",
    "@nx/js": "22.6.1",
    "@nx/node": "22.6.1",
    "@nx/react": "22.6.1",
    "@nx/rollup": "22.6.1",
    "@nx/vite": "22.6.1",
    "@nx/vitest": "22.6.1",
    "@nx/web": "22.6.1",
    "@nx/workspace": "22.6.1",
    "@rollup/plugin-url": "^8.0.2",
    "@svgr/rollup": "^8.1.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.21",
    "@swc/helpers": "0.5.19",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "4.1.1",
    "@vitest/eslint-plugin": "^1.6.6",
    "@vitest/ui": "4.1.1",
    "core-js": "^3.36.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-tsdoc": "^0.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.2.7",
    "nx": "22.6.1",
    "prettier": "^3.7.4",
    "rollup": "^4.57.1",
    "sass": "^1.81.0",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.4.0",
    "typedoc": "^0.28.15",
    "typedoc-plugin-missing-exports": "^4.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "7.3.1",
    "vitest": "4.1.1",
    "vitest-websocket-mock": "^0.5.0"
  }
}
