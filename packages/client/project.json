{
  "name": "client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/client/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "tsc -p tsconfig.spec.json --noEmit",
        "cwd": "packages/client"
      }
    },
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/client",
        "main": "packages/client/src/index.ts",
        "tsConfig": "packages/client/tsconfig.lib.json",
        "format": ["esm", "cjs"],
        "rollupConfig": "packages/client/rollup.config.mjs",
        "generateExportsField": true,
        "sourceMap": true
      },
      "dependsOn": ["typecheck"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../coverage/packages/client"
      }
    },
    "bench": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest bench --run",
        "cwd": "packages/client"
      }
    },
    "docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx typedoc packages/client/src/index.ts --tsconfig packages/client/tsconfig.lib.json --excludeExternals true --readme none"
      }
    }
  }
}
