{
  "name": "client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/client/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:client"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "tsc -p tsconfig.spec.json --noEmit",
        "cwd": "packages/client"
      }
    },
    "build": {
      "dependsOn": ["typecheck"]
    },
    "bench": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest bench --run",
        "cwd": "packages/client"
      }
    },
    "docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx typedoc packages/client/src/index.ts --tsconfig packages/client/tsconfig.lib.json --excludeExternals true --readme none"
      }
    }
  }
}
