{
  "name": "react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "tsc -p tsconfig.spec.json --noEmit",
        "cwd": "packages/react"
      }
    },
    "build": {
      "dependsOn": ["typecheck", "client:build"]
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/packages/react"],
      "options": {
        "config": "./vite.config.mts",
        "coverage.reportsDirectory": "../../coverage/packages/react"
      }
    }
  }
}
